      "content": "export default {\n  routes: {\n    \"/users/:id\": (ctx) => {\n      return Response.json({ userId: ctx.params.id });\n    },\n  },\n  fetch() {\n    return Response.json({ hello: \"world!\" });\n  },\n};\n\n/*\nNode.js: $ npx servok\n          $ pnpx servok\n          $ yarn dlx servok\nDeno:    $ deno run -A npm:servok\nBun:     $ bunx --bun servok\nCLI:     $ servok\n*/",
