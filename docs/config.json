      "content": "export default {\n  routes: {\n    \"/users/:id\": (ctx) => {\n      return Response.json({ userId: ctx.params.id });\n    },\n  },\n  fetch() {\n    return Response.json({ hello: \"world!\" });\n  },\n};\n\n/*\nNode.js: $ npx sevok\n         $ pnpx sevok\n         $ yarn dlx sevok\nDeno:    $ deno run -A npm:sevok\nBun:     $ bunx --bun sevok\nCLI:     $ sevok\n*/",
